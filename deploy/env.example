# 复制为 /opt/autosinin/.env 后按需修改。
# 所有项都是可选的：留空则使用 data/config.json 或内置默认值。

# ---------- 站点 ----------
SITE_NAME=中南林学工自动签到
# 若通过反向代理暴露，填公网地址（用于前端展示）
BASE_URL=
# 时区，签到窗口按此时区计算
TIMEZONE=Asia/Shanghai

# ---------- 管理员账号（唯一） ----------
# 首次启动可以在 /admin 页面直接设置。
# 若希望写死在配置里，用 python tools/set_admin.py 生成哈希后填这里。
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# ---------- 学校接口 ----------
FLYSOURCE_BASE_URL=https://simp.csuft.edu.cn
FLYSOURCE_TENANT_ID=000000
# 学校证书异常时置 1（不建议）
FLYSOURCE_INSECURE=0
REQUEST_TIMEOUT=30

# ---------- 签到窗口（用户要求 21:00-22:30）----------
SIGN_WINDOW_START=21:00
SIGN_WINDOW_END=22:30
# 任务未配置宿舍允许误差时使用的默认值（米）
LOCATION_ACCURACY=30

# ---------- 调度 ----------
# 置 1 可临时关闭自动签到（仅保留网页功能）
SCHEDULER_DISABLED=0

# ---------- 密钥（留空会自动生成到 data/config.json）----------
SECRET_KEY=
ENCRYPTION_KEY=
